                "is_socket_enabled=False",
                "use_laya=True",
                "laya_custom_model=models/laya_automotive_typed_decisions_50k"
            ],
        },
        {
            "name": "main_llm",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "OPENAI_API_KEY": "fake",
            },
            "args": [
                //"ollama_llm=ollama/qwen3.5:4b",
                //"ollama_llm=ollama/qwen2.5:7b-instruct",
                //"data_replay_folder=${workspaceFolder}/../Dataset/assistant/json_output_20260310_113315",
                "mqtt_enabled=True",
