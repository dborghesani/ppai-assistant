{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "main_laya",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "OPENAI_API_KEY": "fake",
            },
            "args": [
                //"ollama_llm=ollama/qwen3.5:4b",
                //"ollama_llm=ollama/qwen2.5:7b-instruct",
                //"data_replay_folder=${workspaceFolder}/../Dataset/assistant/json_output_20260310_113315",
                "mqtt_enabled=True",
                "mqtt_embedded_broker=True",
                "tts_enabled=True",
                "stt_enabled=True",
                "is_socket_enabled=False",
                "use_laya=True",
                //"laya_custom_model=models/laya_automotive_typed_decisions_50k_v3_gpt6"
            ],
        },
        {
            "name": "main_llm",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "OPENAI_API_KEY": "fake",
            },
            "args": [
                "ollama_model=ollama/qwen3.5:4b",
                //"ollama_model=ollama/qwen2.5:7b-instruct",
                "context_window_size=16384",
                "rag_enabled=True",
                "rag_manual_filename=9999_9999_441_en-GB.pdf",
                //"data_replay_folder=${workspaceFolder}/../Dataset/assistant/json_output_20260310_113315",
                "mqtt_enabled=True",
                "mqtt_embedded_broker=True",
                "tts_enabled=True",
                "stt_enabled=True",
                "is_socket_enabled=False",
                "use_laya=False",
                //"laya_custom_model=models/laya_automotive_typed_decisions_50k"
            ],
        },
        {
            "name": "index_vehicle_manual",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.index_vehicle_manual",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "rag_manual_filename=9999_9999_441_en-GB.pdf"
            ]
        },
        {
            "name": "generate_dataset_rules",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_automotive_dataset.py",
            "console": "integratedTerminal",
            "args": [
                "--out-dir", "${workspaceFolder}/../laya/dataset",
                "--version", "1.0",
            ],
        },
        {
            "name": "generate_dataset_distill",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_automotive_dataset_distill.py",
            "console": "integratedTerminal",
            "env": {
                "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
            },
            "args": [
                "--out-dir", "${workspaceFolder}/../laya/dataset",
                "--version", "1.0",
                "--stellantis-llm", "vllm-qwen36-35b-a3b",
            ],
        },
        {
            "name": "pytest: driving",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q",
                "${workspaceFolder}/tests/test_driving.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest: conversation commands",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q",
                "${workspaceFolder}/tests/test_conversation.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest: wellbeing",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q",
                "${workspaceFolder}/tests/test_wellbeing.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}